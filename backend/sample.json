imary\" class=\"hidden md:flex space-x-6\">\n        <a href=\"#hero\" class=\"link link-primary hover:underline\">Home</a>\n        <a href=\"#skills\" class=\"link link-primary hover:underline\">Skills</a>\n        <a href=\"#projects\" class=\"link link-primary hover:underline\">Projects</a>\n        <a href=\"#experience\" class=\"link link-primary hover:underline\">Experience</a>\n        <a href=\"#contact\" class=\"link link-primary hover:underline\">Contact</a>\n      </nav>\n      <button id=\"themeToggle\" class=\"btn btn-ghost btn-sm\" aria-label=\"Toggle dark mode\">\n        <i class=\"fas fa-moon\"></i>\n      </button>\n    </div>\n  </header>\n\n  <main class=\"pt-20\">\n    <!-- Hero Section -->\n    <section id=\"hero\" class=\"bg-primary text-primary-content py-20\" aria-labelledby=\"hero-heading\">\n      <div class=\"max-w-4xl mx-auto text-center px-4\">\n        <h1 id=\"hero-heading\" class=\"text-5xl md:text-6xl font-extrabold mb-4\">Sachin Bisht</h1>\n        <p class=\"text-xl md:text-2xl font-medium mb-6\">Full Stack Developer</p>\n        <p class=\"max-w-2xl mx-auto mb-8\">Dynamic Full Stack Developer with 2 years of hands‑on experience crafting cloud‑native, AI‑powered applications. I blend Java, Python, and React to build scalable systems that solve real problems—evidenced by award‑winning performance and a proven track record of boosting efficiency by up to 87%.</p>\n        <div class=\"flex flex-col sm:flex-row justify-center gap-4\">\n          <a href=\"#contact\" class=\"btn btn-primary btn-lg\">Get in Touch</a>\n          <a href=\"#projects\" class=\"btn btn-outline btn-primary btn-lg\">View Projects</a>\n        </div>\n        <div class=\"flex justify-center space-x-6 mt-8\">\n          <a href=\"mailto:sachin@example.com\" class=\"text-primary-content hover:text-white\" aria-label=\"Email\"><i class=\"fas fa-envelope fa-2x\"></i></a>\n          <a href=\"https://linkedin.com/in/sachin\" target=\"_blank\" rel=\"noopener\" cl